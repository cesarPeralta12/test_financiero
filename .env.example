# Día Uno: variables de entorno de ejemplo. Copia este archivo a .env y ajústalo.
# Nunca subas .env al repositorio: contiene secretos.

# Entorno: development | testing | production (bases de datos separadas por entorno)
APP_ENV=development
PORT=3000
# APP_URL=http://localhost:3000  (obligatoria en producción; en desarrollo se deduce de PORT)
# Ruta de la base de datos (por defecto data/<APP_ENV>.db)
# DATABASE_PATH=./data/development.db

# En producción detrás de un proxy con HTTPS
# TRUST_PROXY=true
# FORCE_HTTPS=true

# Cuenta de administración que crea «npm run seed» (solo datos de prueba en desarrollo)
ADMIN_EMAIL=admin@diauno.test
ADMIN_PASSWORD=Prueba-Admin-2026

# Cuenta de demostración que crea «npm run demo» con datos ficticios (solo desarrollo)
DEMO_EMAIL=demo@diauno.test
DEMO_PASSWORD=Prueba-Demo-2026

# Pasarela de pago (por definir). «sandbox» = pasarela de pruebas integrada.
PAYMENT_GATEWAY=sandbox
# Secreto con el que la pasarela firma sus eventos (obligatorio en producción)
PAYMENT_WEBHOOK_SECRET=whsec_desarrollo_cambiar
PAYMENT_WEBHOOK_TOLERANCE_SEC=300
# URL a la que la pasarela de pruebas envía sus eventos (por defecto APP_URL/webhooks/pagos/sandbox)
# SANDBOX_WEBHOOK_URL=

# Proveedor de IA. Sin clave se usa el proveedor local de desarrollo (sin red ni costo).
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000

# Correo (verificación y recuperación). Sin SMTP, los correos quedan en la bandeja local del panel.
MAIL_FROM="Día Uno <no-responder@diauno.test>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Cola de trabajos dentro del proceso web (false si se usa «npm run worker»)
WORKER_INLINE=true

# Respaldos
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_HOUR=3

# Retención de sesiones anónimas no vinculadas (días)
ANON_RETENTION_DAYS=30
SESSION_DAYS=30
